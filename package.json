{
  "name": "@smgrupa/ui",
  "version": "0.1.0",
  "description": "SMGrupa UI — grupacijski design system za interne aplikacije: tokeni, teme društava, React komponente, upute za Claude Code.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": ["dist", "src", "tokens", "docs", "CLAUDE.app.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:js": "esbuild src/index.ts --bundle --format=esm --platform=browser --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --outfile=dist/index.js",
    "build": "npm run build:tokens && npm run build:css && npm run build:js",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens-only": "node scripts/check-no-hex.mjs",
    "check": "npm run check:contrast && npm run check:tokens-only"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.5"
  },
  "engines": { "node": ">=20" }
}
